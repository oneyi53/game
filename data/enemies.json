[{"aggro_range":220,"attack":8,"attack_cooldown":1.0,"attack_range":40,"color":"#66ff99","defense":0,"hp":40,"id":"slime","is_boss":false,"move_speed":70,"name":"软泥怪"},{"aggro_range":260,"attack":12,"attack_cooldown":0.8,"attack_range":45,"color":"#999999","defense":1,"hp":60,"id":"wolf","is_boss":false,"move_speed":120,"name":"林地狼"},{"aggro_range":320,"attack":20,"attack_cooldown":1.2,"attack_range":60,"color":"#228822","defense":3,"hp":400,"id":"boss_tree","is_boss":true,"leash_range":420,"move_speed":80,"name":"古树守卫","reward_gold":100},{"aggro_range":240,"attack":10,"attack_cooldown":1.0,"attack_range":45,"color":"#3d8b4f","defense":1,"flavor":"它们常在苔冠空地的高草与苔石间活动，喜欢收集散落的亮晶晶小物件。受到惊扰时，它们会迅速聚拢同伴，守住自己的藏身处。","hp":50,"id":"thorn_vine","is_boss":false,"move_speed":60,"name":"荆棘藤蔓"},{"aggro_range":250,"attack":9,"attack_cooldown":0.8,"attack_range":40,"color":"#e8c832","defense":0,"flavor":"它们习惯沿着空地边缘巡游，对陌生脚步声格外敏感。每当林间风向改变，它们便会换一条路线，仿佛在寻找某种熟悉的气息。","hp":35,"id":"forest_wasp","is_boss":false,"move_speed":115,"name":"林地毒蜂"},{"aggro_range":300,"attack":16,"attack_cooldown":1.1,"attack_range":60,"boss_role":"elite","color":"#2e6b3e","defeat_line":"「看来……这片空地，已经可以交给你守护了。」","defense":2,"hp":260,"id":"boss_thorn","is_boss":true,"leash_range":380,"move_speed":90,"name":"苔冠荆棘王","pre_battle_line":"「想越过这片空地，就先让我看看你的勇气吧！」","reward_gold":50},{"aggro_range":240,"attack":9,"attack_cooldown":0.8,"attack_range":40,"color":"#aaff66","defense":0,"flavor":"它们常聚集在林间较为开阔的地带，喜欢追逐被风吹动的种子。别看它们行动轻快，一旦认定目标，就会紧追不放。","hp":35,"id":"valley_firefly","is_boss":false,"move_speed":115,"name":"幽谷萤虫"},{"aggro_range":230,"attack":11,"attack_cooldown":1.1,"attack_range":45,"color":"#8a6b4a","defense":1,"flavor":"它们喜欢躲在倒木和落叶堆之间，把经过的小路当作自己的巡逻路线。遇到动静时，它们会先观察一会儿，再突然冲出来驱赶来客。","hp":60,"id":"withered_puppet","is_boss":false,"move_speed":60,"name":"枯枝傀儡"},{"aggro_range":240,"attack":10,"attack_cooldown":0.9,"attack_range":40,"color":"#66ccff","defense":0,"flavor":"它们偏爱潮湿阴凉的角落，身上常沾着细小的草籽和泥点。它们对周围环境十分熟悉，总能借着地形躲开追击。","hp":45,"id":"stream_spirit","is_boss":false,"move_speed":90,"name":"溪涧水灵"},{"aggro_range":230,"attack":12,"attack_cooldown":1.0,"attack_range":40,"color":"#cc66ff","defense":0,"flavor":"它们通常独自在林间缓慢移动，像是在寻找遗落的东西。受到威胁时，它们会用出乎意料的方式保护自己，不轻易让步。","hp":40,"id":"valley_mushroom","is_boss":false,"move_speed":70,"name":"谷底毒菇"},{"aggro_range":240,"attack":10,"attack_cooldown":0.9,"attack_range":40,"color":"#c9a86a","defense":1,"flavor":"它们常沿着东侧林缘活动，对闪动的光影十分敏感。阳光穿过枝叶时，它们会借着斑驳的影子快速穿行，让人难以判断它们下一步的方向。","hp":50,"id":"dawn_deer","is_boss":false,"move_speed":100,"name":"朝露林鹿"},{"aggro_range":230,"attack":12,"attack_cooldown":1.1,"attack_range":45,"color":"#8a8a8a","defense":1,"flavor":"它们喜欢在林间石坡和灌木之间搬运果实，把找到的食物藏进隐蔽的小洞里。若有人靠近藏食地点，它们便会立刻提高警惕，寸步不让。","hp":60,"id":"hill_rock","is_boss":false,"move_speed":60,"name":"东丘岩怪"}]
