extends SceneTree

const WorldMapManagerScript = preload("res://scripts/core/world_map_manager.gd")

func _initialize() -> void:
    var manager = WorldMapManagerScript.new()
    assert(manager.is_known_map(WorldMapManagerScript.TOWN))
    assert(manager.is_known_map(WorldMapManagerScript.MOSS_CROWN))
    assert(manager.is_known_map(WorldMapManagerScript.FALLEN_LEAF))
    assert(manager.is_known_map(WorldMapManagerScript.MORNING_DEW))
    assert(not manager.is_known_map("unknown_region"))
    assert(manager.map_for_enemy("valley_firefly") == WorldMapManagerScript.FALLEN_LEAF)
    assert(manager.map_for_enemy("dawn_deer") == WorldMapManagerScript.MORNING_DEW)
    assert(manager.map_for_enemy("slime") == WorldMapManagerScript.MOSS_CROWN)
    assert(manager.is_unlocked(WorldMapManagerScript.TOWN, false, false, false, false))
    assert(manager.is_unlocked(WorldMapManagerScript.MOSS_CROWN, false, false, false, false))
    assert(not manager.is_unlocked(WorldMapManagerScript.FALLEN_LEAF, false, false, false, false))
    assert(manager.is_unlocked(WorldMapManagerScript.FALLEN_LEAF, false, true, false, true))
    assert(not manager.is_unlocked(WorldMapManagerScript.MORNING_DEW, false, true, false, true))
    assert(manager.is_unlocked(WorldMapManagerScript.MORNING_DEW, false, true, true, true))
    assert(WorldMapManagerScript.clamp_position(Vector2(-100.0, 2000.0)) == Vector2(32.0, 1368.0))
    assert(manager.map_bounds(WorldMapManagerScript.MOSS_CROWN).size == WorldMapManagerScript.MAP_SIZE)
    assert(manager.has_direct_connection(WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN))
    var town_exit: Dictionary = manager.physical_exit_at(WorldMapManagerScript.TOWN, Vector2(1460.0, 700.0))
    assert(str(town_exit.get("to", "")) == WorldMapManagerScript.MOSS_CROWN)
    assert(manager.physical_exit_at(WorldMapManagerScript.TOWN, Vector2(1300.0, 700.0)).is_empty())
    assert(manager.physical_exit_at(WorldMapManagerScript.MOSS_CROWN, Vector2(1460.0, 700.0)).is_empty())
    assert(manager.physical_exit_at(WorldMapManagerScript.TOWN, Vector2(1545.0, 700.0)).is_empty())
    var valley_gate: Dictionary = manager.physical_exit_at(WorldMapManagerScript.MOSS_CROWN, Vector2(900.0, 790.0))
    assert(str(valley_gate.get("to", "")) == WorldMapManagerScript.FALLEN_LEAF)
    assert(manager.physical_exit_at(WorldMapManagerScript.MOSS_CROWN, Vector2(980.0, 790.0)).is_empty())
    var grove_gate: Dictionary = manager.physical_exit_at(WorldMapManagerScript.FALLEN_LEAF, Vector2(480.0, 1120.0))
    assert(str(grove_gate.get("to", "")) == WorldMapManagerScript.MORNING_DEW)
    assert(manager.has_direct_connection(WorldMapManagerScript.MOSS_CROWN, WorldMapManagerScript.FALLEN_LEAF))
    assert(not manager.has_direct_connection(WorldMapManagerScript.TOWN, WorldMapManagerScript.MORNING_DEW))
    assert(manager.route_between(WorldMapManagerScript.TOWN, WorldMapManagerScript.MORNING_DEW) == [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN, WorldMapManagerScript.FALLEN_LEAF, WorldMapManagerScript.MORNING_DEW])
    assert(manager.route_between("unknown_region", WorldMapManagerScript.TOWN).is_empty())
    var undiscovered_destinations: Array = manager.teleport_destinations(true, true, true, true, false, [WorldMapManagerScript.TOWN])
    assert(undiscovered_destinations.size() == 1, "undiscovered regions must stay hidden")
    assert(str(undiscovered_destinations[0]["id"]) == "town")
    var discovered_locked: Array = manager.teleport_destinations(false, false, false, false, true, [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN, WorldMapManagerScript.FALLEN_LEAF])
    assert(discovered_locked.size() == 3)
    assert(bool(discovered_locked[0]["available"]))
    assert(not bool(discovered_locked[1]["available"]))
    assert(str(discovered_locked[1]["id"]) == "campfire:moss_crown")
    assert(str(discovered_locked[1]["hint"]) == "先激活本区域营火")
    assert(not bool(discovered_locked[2]["available"]))
    var anchors := {WorldMapManagerScript.MOSS_CROWN: Vector2(420.0, 700.0), WorldMapManagerScript.FALLEN_LEAF: Vector2(800.0, 900.0), WorldMapManagerScript.MORNING_DEW: Vector2(500.0, 500.0)}
    var open_destinations: Array = manager.teleport_destinations(true, true, true, true, false, [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN, WorldMapManagerScript.FALLEN_LEAF, WorldMapManagerScript.MORNING_DEW], anchors)
    assert(bool(open_destinations[1]["available"]))
    assert(bool(open_destinations[2]["available"]))
    assert(bool(open_destinations[3]["available"]))
    var town_destination: Dictionary = manager.resolve_teleport_destination("town", false, false, false, false, false, Vector2.ZERO, [WorldMapManagerScript.TOWN])
    assert(bool(town_destination.get("ok", false)))
    assert(town_destination["map_id"] == WorldMapManagerScript.TOWN)
    var locked_destination: Dictionary = manager.resolve_teleport_destination("campfire:fallen_leaf", false, false, false, false, true, Vector2.ZERO, [WorldMapManagerScript.TOWN, WorldMapManagerScript.FALLEN_LEAF], anchors)
    assert(not bool(locked_destination.get("ok", false)))
    var missing_campfire: Dictionary = manager.resolve_teleport_destination("campfire:moss_crown", true, true, true, true, true, Vector2.ZERO, [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN])
    assert(not bool(missing_campfire.get("ok", false)))
    var moss_arrival: Dictionary = manager.resolve_teleport_destination("campfire:moss_crown", true, true, true, true, false, Vector2.ZERO, [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN], anchors)
    assert(bool(moss_arrival.get("ok", false)))
    assert(moss_arrival["position"] == Vector2(420.0, 796.0))
    var valley_arrival: Dictionary = manager.resolve_teleport_destination("campfire:fallen_leaf", true, true, true, true, false, Vector2.ZERO, [WorldMapManagerScript.TOWN, WorldMapManagerScript.FALLEN_LEAF], anchors)
    assert(bool(valley_arrival.get("ok", false)))
    assert(valley_arrival["position"] == Vector2(800.0, 996.0))
    var legacy_global_flag: Array = manager.teleport_destinations(true, true, true, true, true, [WorldMapManagerScript.TOWN, WorldMapManagerScript.MOSS_CROWN])
    assert(not bool(legacy_global_flag[1]["available"]), "global legacy flag must not fabricate a map anchor")
    print("World map manager tests: 44 passed")
    quit()
